import time

class BargeLightingSystem:
    def __init__(self, match_duration=150):
        # State tracking
        self.red_algae_scored = 0
        self.blue_algae_scored = 0
        self.total_segments = 6

        # Timing constants (in seconds)
        self.match_duration = match_duration
        self.endgame_alert = 20
        self.coop_threshold = 2
        self.post_match_delay = 3

        # Internal flags
        self.match_active = False
        self.start_time = 0

    def start_match(self):
        self.start_time = time.time()
        self.match_active = True

    def get_remaining_time(self):
        if not self.match_active:
            return 0
        elapsed = time.time() - self.start_time
        return max(0, self.match_duration - elapsed)

    def update_lights(self):
        remaining = self.get_remaining__time()

        # 1. Post-Match logic (3-second buffer)
        if remaining == 0:
            elapsed_since_end = time.time() - (self.start_time + self.match_duration)
            if elapsed_since_end < self.post_match_delay:
                return "ALL_ON_FOR_REFEREES"
            else:
                return "ÄLL_OFF"

        # 2. Endgame Logic (Final 20 seconds - Flashing)
        if remaining <= self.endgame_alert:
            # Use modulo to create a flash effect every 0.5 seconds
            return "Flashing" if (time.time() % 1.0 > 0.5) else "ALL_OFF"

        # 3. Coopertition Bonus Logic
        # Check if both alliances have hit the threshold
        if self.red_algae_scored >= self.coop_threshold and \
           self.blue_algae_scored >= self.coop_threshold:
            return "ALL_ON_COOP"

        # 4. Standard Scoring Advancement
        # Return how many segments should be lit based on total scored
        total_scored = self.red_algae_scored + self.blue_algae_scored
        return f"SEGMENTS_LIT: {min(total_scored, self.total_segments)}"

# --- Simulation of the Match ---
barge = BargeLightingSystem()
barge.start_match()

# Example: Scoring an Algae
barge.red_algae_scored += 1
print(barge.update_lights()) # Output: SEGMENTs_LIT: 1

